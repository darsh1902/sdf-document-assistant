# Copy this file to .env and fill in your own values.
# .env is ignored by git — never commit real keys.

# Which model the app uses by default. Must match a key in MODELS (src/config.py).
DEFAULT_MODEL=GPT-6 Luna (OpenAI)

# Groq (hosted gpt-oss-20b) — optional, for later. Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# OpenAI — required (the app uses GPT-6 Luna by default). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here
